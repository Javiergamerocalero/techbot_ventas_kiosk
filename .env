# ── San Fernando VTEX integration (2026-08-25) ────────────────────────
# Reporte post-pago al backend VTEX corporativo de SF. Documentacion:
# swagger https://integracionvtexqas.san-fernando.com.pe/api/docs/
# + Diccionario_APIVTEX.xlsx (Javier 2026-08-25).
#
# OFF hasta que:
#   1. SF entregue client_id / client_secret / scope de la app Azure.
#   2. Se apruebe el presupuesto de integracion.
# Cuando llegue: cargar las 3 vars + poner ENABLED=true + rebuild APK.
SANFERNANDO_VTEX_ENABLED=false
SANFERNANDO_VTEX_BASE_URL=https://integracionvtexqas.san-fernando.com.pe
SANFERNANDO_AZURE_TENANT_ID=bc0a31cc-1943-4dea-9a34-02e0fca59160
SANFERNANDO_VTEX_CLIENT_ID=
SANFERNANDO_VTEX_CLIENT_SECRET=
SANFERNANDO_VTEX_SCOPE=

# Direccion default que se manda en cada order (planta / kiosco SF).
# Editar si el kiosco vive en otra sucursal.
SANFERNANDO_ADDRESS=Av. Republica de Panama 3535, San Isidro
SANFERNANDO_ADDRESS_REFERENCE=Kiosco San Fernando
SANFERNANDO_ADDRESS_LAT=-12.0964
SANFERNANDO_ADDRESS_LNG=-77.0264
SANFERNANDO_ADDRESS_UBIGEO=150131
